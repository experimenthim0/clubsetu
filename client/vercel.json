{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/event/:slug",
      "has": [
        {
          "type": "header",
          "key": "User-Agent",
          "value": "(?i)(facebookexternalhit|twitterbot|whatsapp|telegrambot|slackbot|discordbot|googlebot|pinterest|outbrain|copypaste)"
        }
      ],
      "destination": "/api/preview?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}